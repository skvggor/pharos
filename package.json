{
  "name": "@skvggor/pharos",
  "version": "0.1.0",
  "description": "A serif pixel display font for React, rendered as a grid of glowing dots.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Marcos Lima (https://skvggor.dev)",
  "homepage": "https://skvggor.github.io/pharos/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skvggor/pharos.git"
  },
  "bugs": {
    "url": "https://github.com/skvggor/pharos/issues"
  },
  "keywords": [
    "react",
    "pixel-font",
    "display-font",
    "dot-matrix",
    "led",
    "bitmap-font",
    "serif",
    "css"
  ],
  "main": "./dist/pharos.cjs",
  "module": "./dist/pharos.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/pharos.js",
      "require": "./dist/pharos.cjs"
    },
    "./styles.css": "./dist/pharos.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.8"
  }
}
